{
  "manifest_version": 3,
  "name": "Plurall AI",
  "version": "0.1.0",
  "description": "Assistente autorizado para organizar atividades no Plurall.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://atividades.plurall.net/*", "http://localhost:8787/*"],
  "action": {"default_title":"Plurall AI","default_popup":"src/popup/index.html"},
  "background": {"service_worker":"src/background/service-worker.ts","type":"module"},
  "content_scripts": [{"matches":["https://atividades.plurall.net/*"],"js":["src/content/content.ts"],"run_at":"document_idle"}],
  "options_page": "src/options/index.html"
}
